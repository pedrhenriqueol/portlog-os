# Porta do Servidor
PORT=3333
NODE_ENV=development

# URL do Banco PostgreSQL (Local ou Nuvem - Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portlog_db?schema=public"

# Segredos de Autenticação JWT (Em produção, gerar strings aleatórias de 64 caracteres)
JWT_SECRET="portlog_super_secret_jwt_key_2026_dev_only_change_in_prod"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="portlog_super_secret_refresh_key_2026_dev_only"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Domínio permitido do Front-end (CORS)
CLIENT_URL="http://localhost:5173"
COOKIE_DOMAIN="localhost"
